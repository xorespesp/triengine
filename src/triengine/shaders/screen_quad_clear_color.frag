// Screen Quad Clear Color Fragment Shader

////////////////////////////////////////////
// shader inputs
////////////////////////////////////////////
in VS_OUT {
    vec2 texCoord;
} fi;

////////////////////////////////////////////
// shader outputs
////////////////////////////////////////////
layout (location = 0) out vec4 fo_frag;

////////////////////////////////////////////
// shader uniforms
////////////////////////////////////////////
uniform vec4 u_clearColor; // Solid color to fill the screen quad

void main()
{
	fo_frag = u_clearColor; // Fill the screen quad with the solid color
}