// Lineset Object Fragment Shader (forward opaque pass)

////////////////////////////////////////////
// shader inputs
////////////////////////////////////////////
in VS_OUT
{
    vec3 fragColor; // fragment color
} fsi;

////////////////////////////////////////////
// shader outputs
////////////////////////////////////////////
out vec4 fso_fragColor;

void main()
{
    fso_fragColor = vec4(fsi.fragColor, 1.0/* alpha */);
}