@PACKAGE_INIT@

###########################################################
# Use `find_dependency()`
include(CMakeFindDependencyMacro)

find_dependency(OpenGL REQUIRED)
find_dependency(glfw3 REQUIRED) 
find_dependency(Eigen3 REQUIRED)
###########################################################

# `find_package()` has the same effect as `include()`-ing this file, so `CMAKE_CURRENT_LIST_DIR` must be used.
include(${CMAKE_CURRENT_LIST_DIR}/@TRIENGINE_PROJECT_NAME@Targets.cmake)

# Verify that all required components (dependencies) are satisfied
check_required_components(@TRIENGINE_PROJECT_NAME@)